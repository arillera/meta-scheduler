    "schedule": "node schedule-post.js",
    "batch": "node batch-schedule.js"
  },
  "keywords": ["meta", "instagram", "facebook", "scheduler", "playwright", "automation", "carousel"],
  "author": {
    "name": "Antonio Automates",
